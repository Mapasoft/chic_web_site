---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PackageList from '../../components/PackageList.astro';
import Footer from '../../components/Footer.astro';
import { getPlatformPackages } from '../../lib/platform';
---

<Layout title="Platform — Chic Platform Packages" description="Explore Chic's platform packages for macOS applications and graphics.">
  <Navbar />
  <main class="pt-16">
    <PackageList
      modules={getPlatformPackages()}
      basePath="/platform"
      title="Platform"
      description="Platform libraries and bindings for macOS applications, system services, and graphics."
      id="platform"
    />
  </main>
  <Footer />
</Layout>
