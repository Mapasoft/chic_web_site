---
import PackageReference from '../../components/PackageReference.astro';
import { getStdlibPackages } from '../../lib/stdlib';

export function getStaticPaths() {
  return getStdlibPackages().map(pkg => ({ params: { slug: pkg.slug }, props: { pkg } }));
}
const { pkg } = Astro.props;
---

<PackageReference pkg={pkg} collection="Standard Library" indexPath="/stdlib/" backLabel="Back to Packages" />
