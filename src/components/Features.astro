---
const features = [
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>`,
    title: 'Familiar Syntax',
    description: 'Chic brings the clarity and directness of C-style systems programming into the modern era, cleaner syntax, familiar foundations. Evolution, not revolution. Explicit pointers, visible control flow, and just enough modern convenience to remind you why coding close to the machine was fun in the first place.',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
    title: 'No Runtime. No GC.',
    description: 'No garbage collector, no runtime, no hidden layer between your code and the machine. Generics resolve at compile time. What you write is what runs, nothing more, nothing less.',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>`,
    title: 'Explicit Control',
    description: 'You decide how memory is allocated and freed. Chic gives you a range of allocator strategies to match your intent, arena allocators for bulk lifetimes, scratch allocators for temporary work, and a general heap allocator when you need it. No hidden allocations, no surprises.',
  },
];
---

<section id="features" class="pt-4 pb-20 px-6">
  <div class="max-w-6xl mx-auto">
    <div class="grid md:grid-cols-3 gap-8">
      {features.map(feature => (
        <div class="p-7 rounded-3xl border border-chic-border bg-chic-surface/70 hover:border-chic-lavender/40 transition-colors">
          <div class="text-chic-lavender mb-4" set:html={feature.icon} />
          <h3 class="text-xl font-semibold mb-3">{feature.title}</h3>
          <p class="text-chic-muted leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
