---
import type { StdlibPackage } from '../lib/stdlib';

interface Props {
  modules: StdlibPackage[];
  basePath: string;
  title: string;
  description: string;
  id: string;
}
const { modules, basePath, title, description, id } = Astro.props;
---

<section id={id} class="py-20 px-6">
  <div class="max-w-6xl mx-auto">
    <h1 class="section-title text-3xl text-center mb-4">{title}</h1>
    <p class="text-chic-muted text-center mb-10 max-w-xl mx-auto">
      {description}
    </p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {modules.map(mod => (
        <a
          href={`${basePath}/${mod.slug}/`}
          class="block p-5 rounded-lg border border-chic-border bg-chic-surface/60 hover:border-chic-mint/40 transition-colors"
        >
          <div class="flex items-start justify-between gap-4">
            <code class="min-w-0 break-words text-chic-mint text-sm font-mono">{mod.name}</code>
            <span class="text-xs text-chic-muted whitespace-nowrap">{mod.itemCount} docs</span>
          </div>
          <p class="text-chic-muted text-sm mt-2">{mod.description}</p>
          <p class="text-xs text-chic-muted mt-4">
            {[...(mod.enumCount || mod.constantCount ? (mod.structCount ? [`${mod.structCount} structs`] : []) : [`${mod.structCount} structs`]), ...(mod.enumCount ? [`${mod.enumCount} enums`] : []), ...(mod.constantCount ? [`${mod.constantCount} constants`] : []), `${mod.funcCount} funcs`].join(' / ')}
          </p>
        </a>
      ))}
    </div>
  </div>
</section>
