---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import { getDocItemId, type StdlibPackage } from '../lib/stdlib';

interface Props {
  pkg: StdlibPackage;
  collection: string;
  indexPath: string;
  backLabel: string;
}
const { pkg, collection, indexPath, backLabel } = Astro.props;
const visibleConditions = (conditions: string[]) => conditions.filter(condition =>
  !(/^platform\.macos(?:\.|$)/.test(pkg.name) && /^CHIC_OS\s*==\s*builtin\.OS\.MacOs$/.test(condition.trim()))
);
const groups = [
  { title: 'Structs', kind: 'struct', items: pkg.items.filter(item => item.kind === 'struct') },
  { title: 'Enums', kind: 'enum', items: pkg.items.filter(item => item.kind === 'enum') },
  { title: 'Constants', kind: 'constant', items: pkg.items.filter(item => item.kind === 'constant') },
  { title: 'Functions', kind: 'func', items: pkg.items.filter(item => item.kind === 'func') },
].filter(group => group.items.length > 0);
---

<Layout title={`${pkg.name} - Chic ${collection}`} description={pkg.description}>
  <Navbar />
  <main class="package-reference">
    <header class="package-header">
      <div>
        <div class="package-context">
          <a href={indexPath} aria-label={backLabel}>{collection}</a>
        </div>
        <h1 class="section-title">{pkg.name}</h1>
      </div>
    </header>

    <div class="reference-columns">
      <nav class="api-index" aria-label="Package API index">
        {groups.map(group => (
          <details class="index-group" open>
            <summary class={group.kind}>
              <svg class="section-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="m4 2 4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {group.title} <span>{group.items.length}</span>
            </summary>
            <ul>
              {[...group.items].sort((a, b) => a.name.localeCompare(b.name)).map(item => (
                <li><a data-api-link href={`#${getDocItemId(item)}`} title={item.signature}>{item.name}</a></li>
              ))}
            </ul>
          </details>
        ))}
      </nav>

      <div id="reference-panel" class="reference-panel" role="region" aria-label={`${pkg.name} API documentation`} tabindex="0">
        <div class="reference-content">
          <p class="package-description">{pkg.description}</p>
          <p class="reference-scope">{[`${pkg.structCount} structs`, ...(pkg.enumCount ? [`${pkg.enumCount} enums`] : []), ...(pkg.constantCount ? [`${pkg.constantCount} constants`] : []), `${pkg.funcCount} functions`, 'Public API'].join(' · ')}</p>

          {pkg.name === 'builtin' && <aside class="import-note" aria-labelledby="builtin-import-title">
            <h2 id="builtin-import-title">Automatically imported</h2>
            <p>Chic makes <code>builtin</code> available in every package automatically. No <code>import</code> statement is needed. Use the <code>builtin.</code> prefix to access its functions and enum types, such as <code>builtin.get_argc()</code> or <code>builtin.OS</code>. The constants <code>CHIC_OS</code> and <code>CHIC_BUILD_CONFIG</code> are also available directly.</p>
            <pre class="import-example"><code>{`// No import required
main : func() -> i32 {
    return builtin.get_argc()
}`}</code></pre>
          </aside>}

          {pkg.itemCount === 0 && <p class="empty-state">No public structures or functions in this package.</p>}
          {groups.map(group => (
            <section class="declaration-group" aria-labelledby={`reference-${group.kind}`}>
              <h2 id={`reference-${group.kind}`} class={group.kind}>{group.title}</h2>
              {group.items.map(item => (
                <article id={getDocItemId(item)} class="declaration">
                  <header class="declaration-header">
                    <h3><a href={`#${getDocItemId(item)}`}>{item.name}</a></h3>
                    <span class={`kind ${item.kind}`}>{item.kind}</span>
                  </header>
                  {visibleConditions(item.conditions).length > 0 && <p class="conditions">Available when: <code>{visibleConditions(item.conditions).join(' && ')}</code></p>}
                  <pre class="signature"><code>{item.kind === 'func' ? item.signature : [...item.attributes, item.signature].join('\n')}</code></pre>
                  {item.comment && <pre class="description">{item.comment}</pre>}
                </article>
              ))}
            </section>
          ))}
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .package-reference {
    height: 100dvh;
    padding-top: 4rem;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .package-header {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1.25rem 2rem;
    border-bottom: 1px solid #252538;
  }
  .empty-state { margin-top: 2rem; color: #aaaabd; }
  .package-context { display: flex; align-items: center; gap: .65rem; font-size: .75rem; color: #9494ad; }
  .package-context a:hover { color: #eceafa; }
  .package-header > div { min-width: 0; max-width: 100%; }
  h1 { overflow-wrap: anywhere; font-size: 1.5rem; margin-top: .6rem; font-family: 'JetBrains Mono', monospace; }
  .reference-columns { flex: 1; min-height: 0; display: grid; grid-template-columns: 17rem minmax(0, 1fr); }
  .api-index, .reference-panel { overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: #39394c transparent; }
  .api-index { border-right: 1px solid #252538; padding: 1.5rem .75rem 3rem; background: rgb(255 255 255 / 1.5%); }
  .index-group { margin-top: 1.6rem; }
  .index-group:first-child { margin-top: 0; }
  .index-group summary { display: flex; align-items: center; gap: .5rem; padding: .4rem .65rem; font-size: .8rem; font-weight: 600; cursor: pointer; list-style: none; border-radius: .25rem; }
  .index-group summary::-webkit-details-marker { display: none; }
  .index-group summary:hover { background: rgb(196 181 253 / 6%); }
  .index-group summary:focus-visible { outline: 2px solid #c4b5fd; outline-offset: -2px; }
  .index-group summary span { margin-left: auto; color: #9494ad; font-size: .7rem; font-weight: 400; }
  .section-chevron { flex-shrink: 0; }
  .index-group[open] .section-chevron { transform: rotate(90deg); }
  .index-group ul { margin-top: .4rem; }
  .struct { color: #a7f3d0; }
  .func { color: #c4b5fd; }
  .enum { color: #f5e4b0; }
  .constant { color: #e8a0ae; }
  .api-index li + li { margin-top: .1rem; }
  .api-index a { display: block; padding: .45rem .65rem; border-left: 2px solid transparent; border-radius: .25rem; font: .75rem/1.5 'JetBrains Mono', monospace; overflow-wrap: anywhere; color: #aaaabd; }
  .api-index a:hover { color: #eceafa; background: rgb(196 181 253 / 6%); }
  .api-index a[aria-current="location"] { border-left-color: #c4b5fd; background: rgb(196 181 253 / 11%); color: #e1d9ff; }
  a:focus-visible, .reference-panel:focus-visible { outline: 2px solid #c4b5fd; outline-offset: -2px; }
  .reference-panel { scroll-padding-top: 1.5rem; }
  .reference-content { max-width: 64rem; margin: 0 auto; padding: 1.75rem 2rem 65vh; }
  .package-description { color: #aaaabd; font-size: .9rem; line-height: 1.7; max-width: 48rem; }
  .reference-scope { margin-top: .65rem; color: #9494ad; font-size: .75rem; }
  .import-note { margin-top: 1.5rem; border: 1px solid #39314e; border-radius: .6rem; padding: 1.1rem; background: rgb(196 181 253 / 4%); }
  .import-note h2 { color: #c4b5fd; font-size: .95rem; font-weight: 600; }
  .import-note p { margin-top: .6rem; color: #aaaabd; font-size: .85rem; line-height: 1.7; }
  .import-note p code { color: #ddd6fe; font-size: .8rem; }
  .declaration-group { margin-top: 2rem; }
  .declaration-group > h2 { font-size: 1.2rem; font-weight: 600; margin-bottom: 1rem; }
  .declaration { border: 1px solid #252538; border-radius: .6rem; padding: 1.25rem; background: rgb(255 255 255 / 2.5%); }
  .declaration + .declaration { margin-top: 1rem; }
  .declaration:target { border-color: #7c6baf; }
  .declaration-header { display: flex; align-items: flex-start; justify-content: space-between; gap: .75rem; }
  h3 { font: 500 1.1rem/1.5 'JetBrains Mono', monospace; overflow-wrap: anywhere; min-width: 0; }
  .kind { border: 1px solid #39394c; padding: .2rem .4rem; border-radius: .3rem; font: .65rem/1.5 'JetBrains Mono', monospace; }
  .signature, .import-example { margin-top: 1rem; padding: 1rem; border-radius: .4rem; background: rgb(0 0 0 / 20%); border: 1px solid #252538; color: #c4c9ff; overflow-x: auto; font: .8rem/1.7 'JetBrains Mono', monospace; }
  .conditions { margin-top: 1rem; font-size: .8rem; color: #a7f3d0; overflow-wrap: anywhere; }
  .description { white-space: pre-wrap; overflow-wrap: anywhere; margin-top: 1rem; color: #aaaabd; font: .85rem/1.7 Inter, sans-serif; }
  @media (max-width: 767px) {
    .package-header { padding: 1rem; gap: .75rem; }
    h1 { font-size: 1.15rem; }
    .reference-columns { grid-template-columns: 10rem minmax(0, 1fr); }
    .api-index { padding: 1rem .35rem 2rem; }
    .api-index a { font-size: .68rem; padding: .45rem .4rem; }
    .reference-content { padding: 1.25rem .8rem 65vh; }
    .declaration { padding: .8rem; }
    .declaration-header { flex-wrap: wrap; gap: .4rem; }
    h3 { font-size: .9rem; }
  }
</style>

<script>
  const panel = document.getElementById('reference-panel');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-api-link]')];
  const articles = [...document.querySelectorAll<HTMLElement>('.declaration')];
  let activeId = '';
  let scheduled = false;

  // Track the entry at the top of the right panel without moving the left list.
  function updateActiveEntry() {
    scheduled = false;
    if (!panel) return;
    const top = panel.getBoundingClientRect().top + 40;
    let active = articles[0];
    for (const article of articles) {
      if (article.getBoundingClientRect().top > top) break;
      active = article;
    }
    if (!active || active.id === activeId) return;
    activeId = active.id;
    links.forEach(link => {
      if (link.hash === `#${activeId}`) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  }

  panel?.addEventListener('scroll', () => {
    if (!scheduled) {
      scheduled = true;
      requestAnimationFrame(updateActiveEntry);
    }
  }, { passive: true });
  updateActiveEntry();
</script>
