---
import { getStdlibPackages } from '../lib/stdlib';

const modules = getStdlibPackages();
---

<section id="stdlib" class="py-20 px-6">
  <div class="max-w-6xl mx-auto">
    <h2 class="section-title text-3xl text-center mb-4">Standard Library</h2>
    <p class="text-chic-muted text-center mb-10 max-w-xl mx-auto">
      A growing collection of core modules for everyday systems programming.
    </p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {modules.map(mod => (
        <a
          href={`/stdlib/${mod.slug}/`}
          class="block p-5 rounded-lg border border-chic-border bg-chic-surface/60 hover:border-chic-mint/40 transition-colors"
        >
          <div class="flex items-start justify-between gap-4">
            <code class="text-chic-mint text-sm font-mono">{mod.name}</code>
            <span class="text-xs text-chic-muted whitespace-nowrap">{mod.itemCount} docs</span>
          </div>
          <p class="text-chic-muted text-sm mt-2">{mod.description}</p>
          <p class="text-xs text-chic-muted mt-4">
            {mod.structCount} structs / {mod.funcCount} funcs
          </p>
        </a>
      ))}
    </div>
  </div>
</section>
