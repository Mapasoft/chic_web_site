---
const modules = [
  { name: 'core', desc: 'Core utilities and argument parsing' },
  { name: 'core.io', desc: 'File I/O and console operations' },
  { name: 'core.strings', desc: 'String manipulation' },
  { name: 'core.math', desc: 'Math functions (sqrt, trig, abs)' },
  { name: 'core.json', desc: 'JSON parsing' },
  { name: 'core.memory', desc: 'Custom allocators (ArenaAllocator)' },
  { name: 'core.collections', desc: 'Generic Array<T> and List<T>' },
  { name: 'core.os', desc: 'OS-specific functions (macOS, Linux)' },
  { name: 'core.libc', desc: 'C library bindings (malloc, memcpy)' },
];
---

<section id="stdlib" class="py-20 px-6">
  <div class="max-w-6xl mx-auto">
    <h2 class="section-title text-3xl text-center mb-4">Standard Library</h2>
    <p class="text-chic-muted text-center mb-10 max-w-xl mx-auto">
      A growing collection of core modules for everyday systems programming.
    </p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {modules.map(mod => (
        <div class="p-5 rounded-2xl border border-chic-border bg-chic-surface/60 hover:border-chic-mint/40 transition-colors">
          <code class="text-chic-mint text-sm font-mono">{mod.name}</code>
          <p class="text-chic-muted text-sm mt-1">{mod.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
