---
const year = new Date().getFullYear();
---

<footer class="border-t border-chic-border py-10 px-6">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <img src="/static/chic_logo.png" alt="Chic" class="w-6 h-6 rounded-full" />
      <span class="text-sm text-chic-muted">&copy; {year} Chic Programming Language</span>
    </div>

    <div class="flex items-center gap-6">
      <a href="/#features" class="text-sm text-chic-muted hover:text-chic-text transition-colors">Features</a>
      <a href="/#get-started" class="text-sm text-chic-muted hover:text-chic-text transition-colors">Get Started</a>
      <a href="/#stdlib" class="text-sm text-chic-muted hover:text-chic-text transition-colors">Docs</a>
    </div>
  </div>

  <p class="max-w-6xl mx-auto mt-6 text-center text-sm text-chic-muted leading-relaxed">
    Questions? Contact at
    <a
      href="mailto:admin@chic-lang.org"
      class="whitespace-nowrap text-chic-lavender underline underline-offset-4 hover:text-chic-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-chic-lavender rounded-sm transition-colors"
    >admin@chic-lang.org</a>.
  </p>
</footer>
