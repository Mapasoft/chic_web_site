---
const helloCode = `<span class="func">main</span> : <span class="keyword">func</span>() -&gt; <span class="type">i32</span> &#123;
    <span class="func">println</span>(<span class="string">"Hello, World!"</span>)
    <span class="keyword">return</span> <span class="number">0</span>
&#125;`;
---

<section id="get-started" class="py-20 px-6">
  <div class="max-w-4xl mx-auto">
    <h2 class="section-title text-3xl text-center mb-4">Get Started</h2>
    <p class="text-chic-muted text-center mb-10 max-w-xl mx-auto">
      Start with a tiny Chic program and run it locally.
    </p>

    <div class="min-w-0 p-7 rounded-3xl border border-chic-border bg-chic-surface/70">
      <h3 class="text-lg font-semibold mb-4">Your First Program</h3>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="min-w-0">
          <p class="text-sm text-chic-muted mb-3">hello.chic</p>
          <div class="code-block !p-4">
            <pre><code set:html={helloCode} /></pre>
          </div>
        </div>
        <div class="min-w-0">
          <p class="text-sm text-chic-muted mb-3">Compile and run</p>
          <div class="overflow-x-auto bg-chic-surface-2/80 rounded-2xl border border-chic-border p-4 font-mono text-sm space-y-1">
            <div class="text-chic-muted">
              <span class="text-chic-pink">$</span> ./chic compile hello.chic
            </div>
            <div class="text-chic-muted">
              <span class="text-chic-pink">$</span> ./hello
            </div>
            <div class="text-chic-mint">Hello, World!</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
