---
const links = [
  { label: 'Learn', href: '/#get-started' },
  { label: 'Features', href: '/#features' },
  { label: 'Docs', href: '/#stdlib' },
  { label: 'Community', href: '/#community' },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-chic-bg/80 backdrop-blur-md border-b border-chic-border">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 group">
      <img src="/static/chic_logo.png" alt="Chic" class="w-10 h-10 rounded-full" />
      <span class="text-lg font-semibold tracking-wide">Chic</span>
    </a>

    <div class="hidden md:flex items-center gap-8">
      {links.map(link => (
        <a
          href={link.href}
          class="text-sm text-chic-muted hover:text-chic-text transition-colors"
        >
          {link.label}
        </a>
      ))}
      <a
        href="https://github.com/Mapasoft/chic"
        target="_blank"
        rel="noopener noreferrer"
        class="text-chic-muted hover:text-chic-text transition-colors"
        aria-label="GitHub"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>
    </div>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden text-chic-muted hover:text-chic-text"
      aria-label="Toggle menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-chic-border bg-chic-bg/95 backdrop-blur-md">
    <div class="px-6 py-4 flex flex-col gap-4">
      {links.map(link => (
        <a href={link.href} class="text-sm text-chic-muted hover:text-chic-text transition-colors">
          {link.label}
        </a>
      ))}
      <a
        href="https://github.com/Mapasoft/chic"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-chic-muted hover:text-chic-text transition-colors"
      >
        GitHub
      </a>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
  // Close mobile menu when clicking a link
  menu?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => menu?.classList.add('hidden'));
  });
</script>
